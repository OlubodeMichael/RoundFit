{
  "cli": {
    "version": ">= 16.10.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "channel": "development",
      "ios": {
        "scheme": "RoundFit"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "channel": "preview",
      "ios": {
        "scheme": "RoundFit"
      }
    },
    "production": {
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.1",
        "scheme": "RoundFit"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "TWB4M4FQKQ"
      }
    }
  }
}
